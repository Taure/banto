{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {kura, {git, "https://github.com/Taure/kura.git", {tag, "v2.0.6"}}},
    {kura_postgres, {git, "https://github.com/Taure/kura_postgres.git", {tag, "v0.4.2"}}},
    {bunko, {git, "https://github.com/Taure/bunko.git", {tag, "v0.1.1"}}},
    {gakudan, {git, "https://github.com/Taure/gakudan.git", {tag, "v0.1.36"}}},
    {madoguchi, {git, "https://github.com/Taure/madoguchi.git", {tag, "v0.1.3"}}},
    {saiten, {git, "https://github.com/Taure/saiten.git", {tag, "v0.1.2"}}}
]}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    rebar3_lint,
    rebar3_hank,
    {rebar3_kura, "0.13.1"},
    {rebar3_audit, {git, "https://github.com/Taure/rebar3_audit.git", {branch, "main"}}},
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git", {branch, "feat/include-otp-components"}}},
    covertool
]}.

{overrides, [
    {override, kura, [{erl_opts, [debug_info]}]}
]}.

{hex, [{doc, ex_doc}]}.

{erlfmt, [write]}.

{hank, [
    {ignore, [
        "test/**"
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, unmatched_returns, unknown]},
    {plt_apps, all_deps}
]}.

{xref_checks, [undefined_function_calls, undefined_functions]}.

{ct_opts, [{dir, "test"}]}.

{cover_enabled, true}.

{escript_name, banto_cli}.
{escript_main_app, banto}.

{shell, [
    {config, "config/dev_sys.config.src"},
    {apps, [banto]}
]}.

{ex_doc, [
    {extras, [
        <<"README.md">>,
        <<"docs/adr/0001-architecture.md">>,
        <<"docs/adr/0002-review-swarm.md">>,
        <<"docs/adr/0003-maintenance.md">>
    ]},
    {main, <<"readme">>},
    {proglang, erlang},
    {source_url, <<"https://github.com/Taure/banto">>}
]}.
